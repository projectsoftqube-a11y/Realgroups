# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# Contact form delivery (https://resend.com — free tier covers this site's volume)
# Only this key is required; the recipient already defaults to
# realgrouprajkot@gmail.com in app/api/contact/route.ts
RESEND_API_KEY=

# Optional overrides
# CONTACT_TO=realgrouprajkot@gmail.com
#
# Resend will only accept a `from` address on a domain verified in your Resend
# account. Until realgroups.in is verified, the code falls back to Resend's
# sandbox sender, which can ONLY deliver to the email that owns the Resend
# account. Verify the domain, then set this:
# CONTACT_FROM="Real Group <website@realgroups.in>"

# --- SEO verification (optional; the meta tag is omitted when unset) ---
# Google Search Console -> Settings -> Ownership verification -> HTML tag
GOOGLE_SITE_VERIFICATION=
# Meta Business Suite -> Brand safety -> Domains
FACEBOOK_DOMAIN_VERIFICATION=
